# Banana English: settings read by `docker compose` (copy to .env and edit).
# Compose maps each one to the API's BANANA_* variable (see docker-compose.yml). Outside Docker,
# set the BANANA_* names instead, e.g. BANANA_LLM_PROVIDER=ollama BANANA_OLLAMA_MODEL=...

# --- LLM (Ollama) --------------------------------------------------------------------------
LLM_PROVIDER=ollama
# Ollama on the host; with `--profile ollama` use http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434
# Production model: Qwen3-30B-A3B (Ollama library tag, Q4_K_M, 18.6 GB). Pull it once with
# scripts/setup_ollama_model.sh. Memory, quantization and tuning: docs/QWEN3_30B.md
OLLAMA_MODEL=qwen3:30b-a3b-q4_K_M
# Context window sent with every request. 8192 holds the longest chat history without cutting it.
LLM_CONTEXT_LENGTH=8192
# Seconds to wait for one reply. Qwen3-30B-A3B on a laptop (4 GB GPU + CPU): a 2k-token prompt
# reads in ~25 s, replies come at ~12 tokens/s, and a thinking task reasons first (up to
# LLM_THINK_BUDGET tokens). The web proxy waits this + 30 s; rebuild `web` after changing it.
LLM_TIMEOUT_SECONDS=240
# Retries after an error or an invalid reply (never after a timeout).
LLM_MAX_RETRIES=1
# Empty = each task keeps its tuned value (grading 0.0, chat 0.7-0.8, ...).
LLM_TEMPERATURE=
# Empty = each task's own limit; a number caps every reply.
LLM_MAX_OUTPUT_TOKENS=
# How long Ollama keeps the model in RAM after the last request (Ollama duration, e.g. 30m, 2h).
LLM_KEEP_ALIVE=30m
# Load the model when the API starts instead of on the first request.
LLM_WARM_UP=true
# Qwen3 thinking for the tasks that reason (grammar analysis, AI Tutor, AI Monkey explanations);
# false = never think. The reasoning is dropped; learners see only the answer.
LLM_THINKING=true
# Reasoning tokens allowed on top of the answer's own budget.
LLM_THINK_BUDGET=1024
# Optional model used only when OLLAMA_MODEL is unavailable (never on a timeout). Empty = no
# fallback: the production model never changes silently. Example: qwen3:4b-instruct
LLM_FALLBACK_MODEL=

# --- Speech ----------------------------------------------------------------------------------
STT_PROVIDER=whisper
WHISPER_MODEL=base.en
TTS_PROVIDER=piper

# --- Web / deployment ------------------------------------------------------------------------
# Tailscale Funnel (fixed public link, `docker compose --profile funnel up -d`): a one-time auth
# key from the Tailscale admin console (Settings -> Keys). Keep it out of version control.
TS_AUTHKEY=
# true behind HTTPS (the public tunnel)
COOKIE_SECURE=false
REQUIRE_REVIEWED_CONTENT=false
