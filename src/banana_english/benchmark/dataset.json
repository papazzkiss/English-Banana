    {"id": "ge.07", "category": "grammar_explanation",
     "source": {"kind": "tutor", "exercise_id": "gr.past.007", "answer": "I am learning English for five years.", "error_tag": "verb_tense", "assessor_note": "An action that started in the past and continues now needs the present perfect.", "correct_form": "I have been learning English for five years."},
