    {"id": "ge.06", "category": "grammar_explanation",
     "source": {"kind": "tutor", "exercise_id": "gr.present.007", "answer": "I am knowing the answer.", "error_tag": "verb_form", "assessor_note": "'know' is a state verb and is not used in the continuous form.", "correct_form": "I know the answer."},
