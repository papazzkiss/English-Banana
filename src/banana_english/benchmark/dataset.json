{
  "version": "bench_dataset_v1",
  "notes": "Grammar-correction answers and labels come from content/calibration/grammar_calibration.json (labels AI-drafted, not yet teacher-verified). Grammar-explanation mistakes use the real exercises (teacher rule = exercise explanation). Conversations use the real scenarios. Checks are deterministic; see scoring.py.",
  "category_checks": {
    "grammar_correction": [
      {"type": "contract", "dim": "instruction_following", "weight": 2},
      {"type": "no_reasoning_leak", "dim": "naturalness"},
      {"type": "max_sentences", "field": "feedback", "max": 2, "dim": "instruction_following"},
      {"type": "simple_words", "field": "feedback", "dim": "vocabulary"},
      {"type": "not_repetitive", "field": "feedback", "dim": "naturalness"}
    ],
    "grammar_explanation": [
      {"type": "contract", "dim": "instruction_following", "weight": 2},
      {"type": "no_reasoning_leak", "dim": "naturalness"},
      {"type": "min_sentences", "field": "explanation", "min": 2, "dim": "instruction_following"},
      {"type": "max_sentences", "field": "explanation", "max": 4, "dim": "instruction_following"},
      {"type": "simple_words", "field": "explanation", "dim": "vocabulary"},
      {"type": "not_repetitive", "field": "explanation", "dim": "naturalness"}
    ],
    "conversation": [
      {"type": "no_reasoning_leak", "dim": "naturalness"},
      {"type": "max_sentences", "max": 2, "dim": "instruction_following", "weight": 2},
      {"type": "max_words", "max": 45, "dim": "instruction_following"},
      {"type": "not_contains", "field": "raw", "dim": "conversation", "weight": 2,
       "terms": ["as an ai", "language model", "i am an ai", "i'm an ai", "re:\\([^)]*\\)", "re:\\*[^*]+\\*", "re:^\\s*[A-Za-z ]{2,20}:"]},
      {"type": "not_contains", "dim": "conversation", "weight": 2,
       "terms": ["you should say", "correct way", "grammar", "it's better to say", "the right way", "re:\\bwe say\\b", "re:\\binstead of\\b"]},
      {"type": "simple_words", "dim": "vocabulary"},
      {"type": "not_repetitive", "dim": "naturalness"}
    ],
    "vocabulary": [
      {"type": "contract", "dim": "instruction_following", "weight": 2},
      {"type": "no_reasoning_leak", "dim": "naturalness"},
      {"type": "max_sentences", "field": "definition", "max": 1, "dim": "instruction_following"},
      {"type": "max_words", "field": "definition", "max": 25, "dim": "instruction_following"},
      {"type": "max_words", "field": "example", "max": 25, "dim": "naturalness"},
      {"type": "simple_words", "field": "definition", "dim": "vocabulary"}
    ],
    "complex": [
      {"type": "no_reasoning_leak", "dim": "naturalness"},
      {"type": "max_words", "max": 130, "dim": "instruction_following", "weight": 2},
      {"type": "plain_speech", "dim": "instruction_following"},
      {"type": "not_repetitive", "dim": "naturalness"},
      {"type": "simple_words", "dim": "vocabulary"}
    ],
    "voice": [
      {"type": "no_reasoning_leak", "dim": "naturalness"},
      {"type": "plain_speech", "dim": "naturalness", "weight": 2},
      {"type": "max_sentences", "field": "spoken", "max": 3, "dim": "instruction_following", "weight": 2},
      {"type": "max_words", "field": "spoken", "max": 55, "dim": "instruction_following"},
      {"type": "simple_words", "field": "spoken", "dim": "vocabulary"},
      {"type": "not_repetitive", "dim": "naturalness"}
    ]
  },
  "tests": [
