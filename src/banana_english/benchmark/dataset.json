       {"type": "regex", "field": "example", "dim": "grammar", "weight": 2, "pattern": "\\ban\\s+(h?[aeiou]\\w*|hour|honest|honour|heir)\\b"},
       {"type": "differs_from", "field": "example", "dim": "instruction_following", "text": "My sister is an engineer"},
       {"type": "contains_any", "field": "explanation", "dim": "relevance", "terms": ["engineer", "\"an\"", "'an'", " an "]}]},
    {"id": "ge.03", "category": "grammar_explanation",
     "source": {"kind": "tutor", "exercise_id": "gr.compare.002", "answer": "My brother is more taller than me.", "error_tag": "comparative_form", "assessor_note": "Double comparative: 'more' and '-er' together.", "correct_form": "My brother is taller than me."},
