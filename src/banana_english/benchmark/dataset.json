    {"id": "ge.01", "category": "grammar_explanation", "quick": true,
     "source": {"kind": "tutor", "exercise_id": "gr.past.004", "answer": "I have saw that film yesterday.", "error_tag": "verb_tense", "assessor_note": "Present perfect is used with a finished time (yesterday).", "correct_form": "I saw that film yesterday."},
     "checks": [
       {"type": "contains_all", "field": "explanation", "dim": "explanation", "weight": 3, "groups": [["past simple", "simple past", "past tense"], ["yesterday", "finished", "specific time", "time in the past", "exact time", "ended"]]},
       {"type": "regex", "field": "example", "dim": "grammar", "weight": 2, "pattern": "\\b(yesterday|ago|last (week|year|month|night|summer|weekend|monday|sunday)|in (19|20)\\d\\d)\\b"},
       {"type": "not_contains", "field": "example", "dim": "grammar", "terms": ["re:\\b(have|has|'ve|'s) \\w+(ed|en)\\b[^.]*\\b(yesterday|ago|last)\\b"]},
       {"type": "differs_from", "field": "example", "dim": "instruction_following", "text": "I saw that film yesterday"},
       {"type": "contains_any", "field": "explanation", "dim": "relevance", "terms": ["yesterday", "saw", "have"]}]},
    {"id": "ge.02", "category": "grammar_explanation",
     "source": {"kind": "tutor", "exercise_id": "gr.articles.003", "answer": "My sister is a engineer.", "error_tag": "article", "assessor_note": "'a' is used before a vowel sound.", "correct_form": "My sister is an engineer."},
